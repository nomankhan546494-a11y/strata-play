{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cloud gaming user account profile for cross-device identity.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "gamerTag": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "avatarColor": { "type": "string", "minLength": 4, "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "gamerTag", "avatarColor", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Cloud-synced streaming quality, region, audio, and controller preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quality": { "type": "string", "enum": ["720p", "1080p", "1440p", "4K"] },
        "targetFps": { "type": "number" },
        "region": { "type": "string", "enum": ["Tokyo East", "Singapore", "Frankfurt", "US West"] },
        "audioEnabled": { "type": "boolean" },
        "showVirtualControls": { "type": "boolean" },
        "lowLatencyMode": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "quality", "targetFps", "region", "audioEnabled", "showVirtualControls", "lowLatencyMode", "updatedAt"]
    },
    "GameProgress": {
      "title": "GameProgress",
      "description": "Cloud-synced game high score, playtime, library bookmark, and checkpoint resume data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gameId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "highScore": { "type": "number" },
        "totalSeconds": { "type": "number" },
        "sessionsCount": { "type": "number" },
        "savedToLibrary": { "type": "boolean" },
        "checkpointData": { "type": "string", "maxLength": 2048 },
        "lastPlayedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "gameId", "highScore", "totalSeconds", "sessionsCount", "savedToLibrary", "checkpointData", "lastPlayedAt", "updatedAt"]
    },
    "CustomGameLink": {
      "title": "CustomGameLink",
      "description": "User-imported external game link with a custom display name.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customGameId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gameUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https?://.+" },
        "category": { "type": "string", "enum": ["Action", "Racing", "Strategy", "Puzzle", "Custom"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "customGameId", "customName", "gameUrl", "category", "createdAt", "updatedAt"]
    },
    "MultiplayerRoom": {
      "title": "MultiplayerRoom",
      "description": "Joinable cloud multiplayer lobby room.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 4, "maxLength": 16 },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "hostUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hostName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "gameId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mode": { "type": "string", "enum": ["Co-op Survival", "1v1 Duel", "Time Attack"] },
        "region": { "type": "string", "enum": ["Tokyo East", "Singapore", "Frankfurt", "US West"] },
        "playersCurrent": { "type": "number" },
        "playersMax": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "code", "name", "hostUid", "hostName", "gameId", "mode", "region", "playersCurrent", "playersMax", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile document."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User cloud-synced stream settings."
    },
    "/users/{userId}/progress/{gameId}": {
      "schema": { "$ref": "#/entities/GameProgress" },
      "description": "User cloud-synced game progress and resume checkpoints."
    },
    "/users/{userId}/customGames/{customGameId}": {
      "schema": { "$ref": "#/entities/CustomGameLink" },
      "description": "User-added custom game links with custom names."
    },
    "/multiplayerRooms/{roomId}": {
      "schema": { "$ref": "#/entities/MultiplayerRoom" },
      "description": "Active cloud multiplayer lobbies."
    }
  }
}
